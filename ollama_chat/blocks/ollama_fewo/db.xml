<?xml version="1.0"?>
<schema
    xmlns="http://www.concrete5.org/doctrine-xml/0.5"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    <table name="btOllamaFewo">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="title" type="string" size="255"/>
        <field name="contactPageID" type="integer">
            <unsigned/>
            <notnull/>
            <default value="0"/>
        </field>
        <field name="ollamaUrl" type="string" size="255">
            <notnull/>
        </field>
        <field name="model" type="string" size="100">
            <notnull/>
        </field>
        <field name="contextSize" type="integer">
            <unsigned/>
            <notnull/>
            <default value="8192"/>
        </field>
        <field name="maxDataAgeHours" type="integer">
            <unsigned/>
            <notnull/>
            <default value="24"/>
        </field>
    </table>
</schema>
