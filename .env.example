# Copy to .env and adjust: cp .env.example .env
# The values marked "required" have no default; docker compose refuses to start without them.

# --- Database ---
DB_DATABASE=concrete
DB_USER=concrete
# required
DB_PASSWORD=
# required
DB_ROOT_PASSWORD=

# --- Concrete ---
# Image with Concrete CMS (unpacked under /srv/app/public, Apache on port 80)
C5_IMAGE=fehrenbacher/concrete5:9.5.4_php8.4.25
# Address and port on the host. 127.0.0.1 = only this computer, 0.0.0.0 = whole network
C5_BIND=127.0.0.1
C5_PORT=8080
# Address under which the site is opened in the browser, with a trailing slash
C5_CANONICAL_URL=http://localhost:8080/
C5_SITE_NAME=Concrete mit Ollama
# atomik_full (with demo content), atomik_blank, elemental_full or elemental_blank
C5_STARTING_POINT=atomik_full
C5_ADMIN_EMAIL=admin@example.com
# required; at least 8 characters
C5_ADMIN_PASSWORD=

# --- Ollama ---
OLLAMA_VERSION=0.40.16
# Model for the chat; downloaded on the first start (llama3: about 4.7 GB)
OLLAMA_MODEL=llama3:latest
# How long the model stays in memory after the last question
OLLAMA_KEEP_ALIVE=30m
